(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the cup on the plate)
    (:regions
      (cup_init_region
          (:target living_room_table)
          (:ranges (
              (-0.13 -0.02 -0.09 0.02)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_region
          (:target living_room_table)
          (:ranges (
              (0.08 -0.02 0.12 0.02)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    red_coffee_mug_1 - red_coffee_mug
    plate_1 - plate
  )

  (:obj_of_interest
    red_coffee_mug_1
    plate_1
  )

  (:init
    (On red_coffee_mug_1 living_room_table_cup_init_region)
    (On plate_1 living_room_table_plate_region)
  )

  (:goal
    (And (On red_coffee_mug_1 plate_1))
  )

)
